@model RecurringFormVm
@{ var templateRow = new VoucherLineRowVm { Index = "__i__", WithDimensions = false }; }
<div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
<div class="sheet">
    <div class="row g-3">
        <div class="col-md-4"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" placeholder="e.g. Office rent" /><span asp-validation-for="Name" class="text-danger small"></span></div>
        <div class="col-md-2"><label asp-for="VoucherType" class="form-label"></label><select asp-for="VoucherType" asp-items="Html.GetEnumSelectList<VoucherType>()" class="form-select" data-voucher-type></select></div>
        <div class="col-md-2"><label asp-for="Frequency" class="form-label"></label><select asp-for="Frequency" asp-items="Html.GetEnumSelectList<RecurrenceFrequency>()" class="form-select"></select></div>
        <div class="col-md-2"><label asp-for="NextRunDate" class="form-label"></label><input asp-for="NextRunDate" type="date" class="form-control" /></div>
        <div class="col-md-2"><label asp-for="EndDate" class="form-label"></label><input asp-for="EndDate" type="date" class="form-control" /></div>
        <div class="col-md-10"><label asp-for="Narration" class="form-label"></label><input asp-for="Narration" class="form-control" /></div>
        <div class="col-md-2 d-flex align-items-end"><div class="form-check"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label"></label></div></div>
        <div class="col-12"><div class="type-hint" id="type-hint"></div></div>
    </div>
</div>
<div class="sheet flush">
    <div class="table-wrap" data-line-editor data-template="line-template">
        <table class="voucher-lines w-100">
            <thead><tr class="small text-secondary"><th></th><th class="px-2 pt-3">Account</th><th class="px-2 pt-3 text-end">Debit</th><th class="px-2 pt-3 text-end">Credit</th><th class="px-2 pt-3">Note</th><th></th></tr></thead>
            <tbody class="lines">
                @for (int i = 0; i < Model.Lines.Count; i++)
                {
                    <partial name="_VoucherLine" model="new VoucherLineRowVm { Line = Model.Lines[i], Index = i.ToString(), WithDimensions = false }" />
                }
            </tbody>
        </table>
    </div>
    <div class="d-flex gap-2 px-3 py-2"><button type="button" class="btn btn-sm btn-outline-primary" id="add-line"><i class="bi bi-plus"></i> Add line</button>
        <button type="button" class="btn btn-sm btn-outline-primary" id="balance-line">Balance the difference</button></div>
    <div class="balance-bar">
        <div><div class="k">Total debit</div><div class="v dr" id="total-dr">0.00</div></div>
        <div><div class="k">Total credit</div><div class="v cr" id="total-cr">0.00</div></div>
        <div><div class="k">Difference</div><div class="v" id="diff">0.00</div></div>
        <div class="balance-state off" id="balance-state">Enter amounts</div>
    </div>
</div>
<template id="line-template"><partial name="_VoucherLine" model="templateRow" /></template>
