@model FiscalYear
@{ ViewData["Title"] = "New fiscal year"; }
<div class="page-head"><div><h1>New fiscal year</h1><p class="sub">Bangladesh's fiscal year runs from 1 July to 30 June. The dates below continue from the last year on file.</p></div></div>
<div class="sheet" style="max-width:640px">
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
        <div class="mb-3"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger small"></span></div>
        <div class="row g-3 mb-4">
            <div class="col"><label asp-for="StartDate" class="form-label"></label><input asp-for="StartDate" type="date" class="form-control" /><span asp-validation-for="StartDate" class="text-danger small"></span></div>
            <div class="col"><label asp-for="EndDate" class="form-label"></label><input asp-for="EndDate" type="date" class="form-control" /><span asp-validation-for="EndDate" class="text-danger small"></span></div>
        </div>
        <button class="btn btn-primary" type="submit">Create fiscal year</button> <a class="btn btn-link" asp-action="Index">Cancel</a>
    </form>
</div>
