@model List<Voucher>
@{
    ViewData["Title"] = "Approvals";
    var risks = (Dictionary<int, AnomalyItem>)ViewBag.Risks;
    bool sod = (bool)ViewBag.SoD;
    int me = (int)ViewBag.Me;
}
<div class="page-head">
    <div><h1>Approvals</h1><p class="sub">Vouchers waiting for a second pair of eyes. Each is risk-scored before you approve, so unusual entries stand out.</p></div>
</div>
@if (!Model.Any())
{
    <div class="sheet empty"><i class="bi bi-check2-all"></i>Nothing is waiting for approval.</div>
}
@foreach (var v in Model)
{
    risks.TryGetValue(v.Id, out var r);
    bool own = sod && v.CreatedById == me;
    <div class="sheet">
        <div class="d-flex flex-wrap gap-3 align-items-start">
            <div class="flex-grow-1">
                <div class="d-flex align-items-baseline gap-2 flex-wrap">
                    <a asp-action="Details" asp-route-id="@v.Id" style="font-family:var(--font-title);font-size:1.25rem">@v.VoucherNo</a>
                    <span class="small-print">@v.VoucherType · @Fmt.Date(v.VoucherDate) · by @v.CreatedBy?.FullName, submitted @Fmt.DateTime(v.SubmittedAt)</span>
                </div>
                <p class="mb-2">@v.Narration</p>
                <table class="ledger" style="max-width:640px">
                    <tbody>
                    @foreach (var d in v.Details.OrderBy(d => d.LineNo))
                    {
                        <tr><td>@d.Account?.Code — @d.Account?.Name</td><td class="num dr">@Fmt.MoneyOrBlank(d.Debit)</td><td class="num cr">@Fmt.MoneyOrBlank(d.Credit)</td></tr>
                    }
                    </tbody>
                    <tfoot><tr><td>Total</td><td class="num">@Fmt.Money(v.TotalAmount)</td><td class="num">@Fmt.Money(v.TotalAmount)</td></tr></tfoot>
                </table>
            </div>
            <div style="min-width:260px;max-width:360px">
                @if (r != null)
                {
                    <div class="mb-2"><span class="chip risk-@r.Level">@(r.Level == "None" ? "No flags" : r.Level + " risk · " + r.Score)</span></div>
                    @foreach (var x in r.Reasons) { <div class="reason"><b>@x.Rule</b> <span class="pts">+@x.Points</span><br />@x.Detail</div> }
                }
                <div class="d-flex gap-2 mt-3">
                    @if (own)
                    {
                        <span class="small-print">You entered this voucher, so another user must approve it.</span>
                    }
                    else
                    {
                        <form asp-action="Approve" asp-route-id="@v.Id" asp-route-returnTo="queue" method="post"><button class="btn btn-primary btn-sm" type="submit"><i class="bi bi-check2"></i> Approve &amp; post</button></form>
                        <form asp-action="Reject" asp-route-id="@v.Id" asp-route-returnTo="queue" method="post" data-reject><input type="hidden" name="reason" /><button class="btn btn-outline-danger btn-sm" type="submit">Return</button></form>
                    }
                </div>
            </div>
        </div>
    </div>
}
