@model AnomalyReportVm
@{ ViewData["Title"] = "Transaction risk scoring"; }
<div class="page-head">
    <div><h1>Transaction risk scoring</h1><p class="sub">Each posted voucher is checked against ten transparent rules. Points add up to a 0–100 score: 50+ is high, 25+ medium. Every flag states its reason, so a reviewer can agree or dismiss it in seconds.</p></div>
    <div class="actions"><partial name="_ExportLink" /></div>
</div>
<form method="get" class="sheet filters">
    <div><label class="form-label small">From</label><input type="date" name="from" value="@Fmt.Iso(Model.From)" class="form-control" /></div>
    <div><label class="form-label small">To</label><input type="date" name="to" value="@Fmt.Iso(Model.To)" class="form-control" /></div>
    <div><label class="form-label small">Show</label><select name="level" class="form-select">
        @foreach (var l in new[] { "Low", "Medium", "High" }) { <option value="@l" selected="@(Model.MinLevel == l)">@l risk and above</option> }</select></div>
    <div><button class="btn btn-primary" type="submit">Score</button></div>
</form>
<div class="figures">
    <div class="figure"><div class="label">Vouchers scanned</div><div class="value">@Model.Scanned</div></div>
    <div class="figure"><div class="label">High risk</div><div class="value st-bad">@Model.CountHigh</div></div>
    <div class="figure"><div class="label">Medium risk</div><div class="value st-warn">@Model.CountMedium</div></div>
    <div class="figure"><div class="label">Low risk</div><div class="value">@Model.CountLow</div></div>
</div>
<div class="sheet flush">
    <div class="table-wrap">
    <table class="ledger">
        <thead><tr><th>Voucher</th><th>Entered</th><th>Reasons</th><th class="num">Amount</th><th class="num">Score</th></tr></thead>
        <tbody>
        @foreach (var i in Model.Items)
        {
            <tr>
                <td><a asp-controller="Vouchers" asp-action="Details" asp-route-id="@i.VoucherId">@i.VoucherNo</a><div class="small-print">@i.Type · @Fmt.Date(i.Date)</div><div class="small-print">@i.Narration</div></td>
                <td class="small-print">@Fmt.DateTime(i.CreatedAt)<br />@i.CreatedBy</td>
                <td>@foreach (var r in i.Reasons) { <div class="reason"><b>@r.Rule</b> <span class="pts">+@r.Points</span> — @r.Detail</div> }</td>
                <td class="num">@Fmt.Money(i.Amount)</td>
                <td class="num"><span class="chip risk-@i.Level">@i.Score · @i.Level</span></td>
            </tr>
        }
        @if (!Model.Items.Any()) { <tr><td colspan="5" class="empty"><i class="bi bi-shield-check"></i>Nothing flagged at this level.</td></tr> }
        </tbody>
    </table>
    </div>
</div>
<div class="sheet">
    <h2>The rules</h2>
    <div class="table-wrap">
    <table class="ledger">
        <thead><tr><th>Rule</th><th>Fires when</th><th class="num">Points</th></tr></thead>
        <tbody>
            <tr><td>Statistical outlier</td><td>A line exceeds its account's historical mean by the z-score threshold in Settings (n ≥ 8)</td><td class="num">35</td></tr>
            <tr><td>Possible duplicate</td><td>Same amount and same accounts on both sides within 7 days</td><td class="num">25</td></tr>
            <tr><td>Just below threshold</td><td>Within 5% under the large-transaction review limit</td><td class="num">20</td></tr>
            <tr><td>Large transaction</td><td>At or above the review limit</td><td class="num">15</td></tr>
            <tr><td>Self-approved</td><td>Creator and approver are the same user</td><td class="num">15</td></tr>
            <tr><td>Backdated</td><td>Recorded more than the tolerance (days) after its voucher date</td><td class="num">15</td></tr>
            <tr><td>Round amount</td><td>10,000 or more and an exact multiple of 1,000</td><td class="num">10</td></tr>
            <tr><td>Weekend entry</td><td>Entered on a configured weekend day</td><td class="num">10</td></tr>
            <tr><td>Out of hours</td><td>Entered before 08:00 or after 21:00</td><td class="num">10</td></tr>
            <tr><td>No narration</td><td>The voucher has no description</td><td class="num">5</td></tr>
        </tbody>
    </table>
    </div>
</div>
