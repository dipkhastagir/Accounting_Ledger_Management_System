@model List<CostCenter>
@{
    ViewData["Title"] = "Cost centres";
    var usage = (Dictionary<int, int>)ViewBag.Usage;
    bool canEdit = User.IsInRole("Admin") || User.IsInRole("Accountant");
}
<div class="page-head">
    <div><h1>Cost centres</h1><p class="sub">Departments or projects that income and expenses can be tagged to.</p></div>
    <div class="actions"><a class="btn btn-outline-primary" asp-controller="Reports" asp-action="CostCenters">Cost centre report</a>
        @if (canEdit) { <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg"></i> New cost centre</a> }</div>
</div>
<div class="sheet flush">
    <table class="ledger">
        <thead><tr><th>Code</th><th>Name</th><th>Description</th><th class="num">Lines tagged</th><th></th></tr></thead>
        <tbody>
        @foreach (var c in Model)
        {
            <tr><td>@c.Code</td><td>@c.Name @if (!c.IsActive) { <span class="chip st-draft">Inactive</span> }</td><td class="small-print">@c.Description</td>
                <td class="num">@(usage.TryGetValue(c.Id, out var n) ? n : 0)</td>
                <td class="text-end">@if (canEdit) { <a asp-action="Edit" asp-route-id="@c.Id" title="Edit"><i class="bi bi-pencil"></i></a> <a class="ms-2 text-danger" asp-action="Delete" asp-route-id="@c.Id" title="Delete"><i class="bi bi-trash"></i></a> }</td></tr>
        }
        </tbody>
    </table>
</div>
