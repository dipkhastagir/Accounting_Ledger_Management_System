@model VoucherLineRowVm
@{
    var accounts = (List<ChartOfAccount>)ViewBag.Accounts;
    var centers = ViewBag.CostCenters as List<CostCenter> ?? new List<CostCenter>();
    var parties = ViewBag.Parties as List<Party> ?? new List<Party>();
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    var i = Model.Index;
    var l = Model.Line;
}
<tr class="line">
    <td class="line-no muted small text-center" style="width:28px"></td>
    <td style="min-width:240px">
        <select name="Lines[@i].AccountId" class="form-select f-account" aria-label="Account">
            <option value="0">Choose account…</option>
            @foreach (var g in accounts.GroupBy(a => a.AccountType))
            {
                <optgroup label="@g.Key">
                    @foreach (var a in g)
                    {
                        <option value="@a.Id" selected="@(a.Id == l.AccountId)">@a.Code — @a.Name@(a.IsCashOrBank ? " ◆" : "")</option>
                    }
                </optgroup>
            }
        </select>
    </td>
    <td><input name="Lines[@i].Debit" type="number" step="0.01" min="0" class="form-control amount f-debit" placeholder="Debit" aria-label="Debit" value="@(l.Debit == 0 ? "" : l.Debit.ToString("0.00", inv))" /></td>
    <td><input name="Lines[@i].Credit" type="number" step="0.01" min="0" class="form-control amount f-credit" placeholder="Credit" aria-label="Credit" value="@(l.Credit == 0 ? "" : l.Credit.ToString("0.00", inv))" /></td>
    @if (Model.WithDimensions)
    {
        <td style="min-width:140px">
            <select name="Lines[@i].CostCenterId" class="form-select" aria-label="Cost centre">
                <option value="">—</option>
                @foreach (var c in centers) { <option value="@c.Id" selected="@(c.Id == l.CostCenterId)">@c.Code</option> }
            </select>
        </td>
        <td style="min-width:170px">
            <select name="Lines[@i].PartyId" class="form-select" aria-label="Party">
                <option value="">—</option>
                @foreach (var p in parties) { <option value="@p.Id" selected="@(p.Id == l.PartyId)">@p.Name</option> }
            </select>
        </td>
    }
    <td style="min-width:160px"><input name="Lines[@i].LineNarration" class="form-control f-note" placeholder="Line note" aria-label="Line note" value="@l.LineNarration" maxlength="250" /></td>
    <td style="width:36px"><button type="button" class="btn btn-sm btn-link text-danger remove-line" title="Remove line" aria-label="Remove line"><i class="bi bi-x-lg"></i></button></td>
</tr>
