@model ResetPasswordVm
@{ ViewData["Title"] = "Reset password"; }
<div class="page-head"><div><h1>Reset password for @Model.Username</h1><p class="sub">Share the new password securely; the user can change it after signing in.</p></div></div>
<div class="sheet" style="max-width:520px">
    <form asp-action="ResetPassword" method="post">
        <input type="hidden" asp-for="Id" /><input type="hidden" asp-for="Username" />
        <div class="mb-4"><label asp-for="NewPassword" class="form-label"></label><input asp-for="NewPassword" class="form-control" autocomplete="new-password" /><span asp-validation-for="NewPassword" class="text-danger small"></span></div>
        <button class="btn btn-primary" type="submit">Reset password</button> <a class="btn btn-link" asp-action="Index">Cancel</a>
    </form>
</div>
